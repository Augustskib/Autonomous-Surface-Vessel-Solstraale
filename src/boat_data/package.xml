<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>boat_data</name>
  <version>0.1.0</version>
  <description>Mission-aware rosbag2 (MCAP) recorder with a run archive and write monitoring.</description>
  <maintainer email="augustskib@users.noreply.github.com">August Ramberg</maintainer>
  <license>MIT</license>
  <depend>std_msgs</depend>
  <depend>rclpy</depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
