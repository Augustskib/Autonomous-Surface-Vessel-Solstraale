<?xml version="1.0" ?>
<!--
  boat_world.sdf: twin-pontoon catamaran on flat water.

  "hull" is the frame and electronics boxes, with no collision of its own.
  left_pontoon and right_pontoon use meshes/hull.stl for visuals and simple
  boxes for collision, and each carries buoyancy, drag and a propeller.

  Masses, inertias, pontoon spacing (0.7 m beam) and drag coefficients are
  estimates, not measurements. Total mass is about 9.4 kg.
-->
<sdf version="1.8">
  <world name="boat_world">
    <!-- Georeference the origin. Without spherical_coordinates the navsat
         sensor publishes 0/0/0. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <!-- Lake Eola Park, Orlando FL. Arbitrary, chosen because the map has
         detail there. Change to the real test site. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>28.543611</latitude_deg>
      <longitude_deg>-81.372778</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <!-- 1 ms step. 0.0005 made the sim run far below real time (camera at
         under 1 Hz), and since the nodes do not use sim time that triggered
         the GPS-loss timeout. 0.002 let the boat flip under thrust.
         FCL instead of the default ODE collision detector, which crashed
         with "ODE INTERNAL ERROR 1: assertion aabbBound". -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>fcl</collision_detector>
      </dart>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <!-- Needed for the navsat sensor to publish. -->
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <!-- Graded buoyancy, so there is a water line at z=0 and partial
         submersion is computed. uniform_fluid_density treats the whole world
         as water: constant lift, no restoring moment, and the boat flew and
         flipped. Above z=0 the density is air. About 65% of each pontoon is
         submerged at rest. -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>boat</enable>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Water surface. The collision is a large finite box, not a plane:
         an infinite plane crashed the ODE broadphase. Buoyancy does not read
         this geometry, it assumes the water line is z=0. -->
    <model name="water_plane">
      <static>true</static>
      <link name="link">
        <!-- Top face at z=-1 so the pontoons never touch it. It is only a
             catch-all floor. Zero friction. -->
        <collision name="collision">
          <pose>0 0 -5 0 0 0</pose>
          <geometry>
            <box><size>400 400 8</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.6 1</ambient>
            <diffuse>0.1 0.4 0.7 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- The boat. -->
    <model name="boat">
      <!-- Spawn just above the equilibrium height (~0.23 m) so the boat
           settles instead of dropping into the water. -->
      <pose>0 0 0.25 0 0 0</pose>
      <static>false</static>

      <link name="hull">
        <!-- Hull 6.4 kg, pontoons 1.5 kg each. Chosen so about 65% of
             the pontoon volume is submerged at rest. Inertia scaled with
             mass. -->
        <inertial>
          <mass>6.4</mass>
          <inertia>
            <ixx>0.166</ixx><iyy>0.224</iyy><izz>0.326</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>

        <!-- Two electronics boxes, visual only. -->
        <visual name="box_left_visual">
          <pose>0 0.11 0 0 0 0</pose>
          <geometry>
            <box><size>0.30 0.20 0.25</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <visual name="box_right_visual">
          <pose>0 -0.11 0 0 0 0</pose>
          <geometry>
            <box><size>0.30 0.20 0.25</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <!-- GPS, bridged to boat/gps/fix like the real gps_publisher. -->
        <sensor name="gps_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>boat/navsat</topic>
        </sensor>

        <!-- IMU, bridged to boat/imu. No noise modelled. -->
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <topic>boat/imu</topic>
        </sensor>

        <!-- Camera, bridged to boat/camera/image_raw. Raised and tilted
             down so part of the boat is in frame. -->
        <sensor name="camera_sensor" type="camera">
          <pose>0.2 0 0.25 0 0.3 0</pose>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>boat/camera</topic>
          <camera>
            <horizontal_fov>1.1</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>200</far>
            </clip>
          </camera>
        </sensor>
      </link>

      <!-- Left pontoon: hull.stl visual, box collision (a mesh would make
           the buoyancy volume harder to compute). 0.35 m either side of
           centre. -->
      <link name="left_pontoon">
        <pose relative_to="hull">0 0.35 -0.25 0 0 0</pose>
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.00152</ixx><iyy>0.101</iyy><izz>0.101</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <!-- Three collision boxes (bow, mid, stern). Buoyancy acts at the
             centre of each collision element, so a single box gives no pitch
             restoring moment. -->
        <collision name="collision_bow">
          <pose>0.3 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.3 0.09 0.09</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="collision_mid">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.3 0.09 0.09</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="collision_stern">
          <pose>-0.3 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.3 0.09 0.09</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <!-- The STL is in centimetres (scale 0.01), off-centre, and long
             along Y. This pose centres it and turns the rounded bow to +X. -->
        <visual name="visual">
          <pose>-0.32245 -0.1448 0.0518 0 0 1.5707963</pose>
          <geometry>
            <mesh>
              <uri>../meshes/hull.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="left_pontoon_joint" type="fixed">
        <parent>hull</parent>
        <child>left_pontoon</child>
      </joint>

      <!-- Right pontoon: mirror of left_pontoon. -->
      <link name="right_pontoon">
        <pose relative_to="hull">0 -0.35 -0.25 0 0 0</pose>
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.00152</ixx><iyy>0.101</iyy><izz>0.101</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <!-- Bow, mid and stern boxes, see left_pontoon. -->
        <collision name="collision_bow">
          <pose>0.3 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.3 0.09 0.09</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="collision_mid">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.3 0.09 0.09</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="collision_stern">
          <pose>-0.3 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.3 0.09 0.09</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <pose>-0.32245 -0.1448 0.0518 0 0 1.5707963</pose>
          <geometry>
            <mesh>
              <uri>../meshes/hull.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="right_pontoon_joint" type="fixed">
        <parent>hull</parent>
        <child>right_pontoon</child>
      </joint>

      <!-- Propellers, one at the stern of each pontoon, on revolute joints
           driven by the Thruster plugins below. -->
      <link name="left_propeller">
        <pose relative_to="left_pontoon">-0.42 0 0 0 1.5707963 0</pose>
        <!-- Small nonzero inertia. Without it the joint mass matrix is
             singular and the pose goes NaN on the first step. -->
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.05</radius><length>0.05</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="left_propeller_joint" type="revolute">
        <parent>left_pontoon</parent>
        <child>left_propeller</child>
        <axis>
          <xyz expressed_in="left_pontoon">1 0 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <link name="right_propeller">
        <pose relative_to="right_pontoon">-0.42 0 0 0 1.5707963 0</pose>
        <!-- Same missing-<inertial> fix as left_propeller above. -->
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00005</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.05</radius><length>0.05</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <joint name="right_propeller_joint" type="revolute">
        <parent>right_pontoon</parent>
        <child>right_propeller</child>
        <axis>
          <xyz expressed_in="right_pontoon">1 0 0</xyz>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <!-- Hydrodynamics (drag), one per pontoon. Without it the boat
           accelerates without limit and coasts forever. Quadratic terms use
           the SNAME names (xUabsU etc.); unknown names are silently ignored.
           See https://gazebosim.org/api/sim/8/theory_hydrodynamics.html -->
      <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
        <link_name>left_pontoon</link_name>
        <!-- Overdamped on purpose so the boat is easy to drive and hard to
             tip. Roll and pitch damping are high. Surge drag is lower so it
             does not cap top speed. -->
        <xU>-4</xU>
        <xUabsU>-6</xUabsU>
        <yV>-12</yV>
        <yVabsV>-20</yVabsV>
        <zW>-50</zW>
        <zWabsW>-100</zWabsW>
        <kP>-40</kP>
        <kPabsP>-70</kPabsP>
        <mQ>-40</mQ>
        <mQabsQ>-70</mQabsQ>
        <nR>-8</nR>
        <nRabsR>-15</nRabsR>
      </plugin>
      <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
        <link_name>right_pontoon</link_name>
        <!-- Same values as the left pontoon. -->
        <xU>-4</xU>
        <xUabsU>-6</xUabsU>
        <yV>-12</yV>
        <yVabsV>-20</yVabsV>
        <zW>-50</zW>
        <zWabsW>-100</zWabsW>
        <kP>-40</kP>
        <kPabsP>-70</kPabsP>
        <mQ>-40</mQ>
        <mQabsQ>-70</mQabsQ>
        <nR>-8</nR>
        <nRabsR>-15</nRabsR>
      </plugin>

      <!-- Thruster plugins, one per propeller. Each takes thrust in newtons
           on its own topic. thrust_splitter publishes left and right, so
           steering comes from the difference. -->
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
        <joint_name>left_propeller_joint</joint_name>
        <thrust_coefficient>0.005</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.1</propeller_diameter>
        <use_angvel_cmd>false</use_angvel_cmd>
      </plugin>
      <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
        <joint_name>right_propeller_joint</joint_name>
        <thrust_coefficient>0.005</thrust_coefficient>
        <fluid_density>1000</fluid_density>
        <propeller_diameter>0.1</propeller_diameter>
        <use_angvel_cmd>false</use_angvel_cmd>
      </plugin>
    </model>

    <!-- Target marker 1 -->
    <model name="target_1">
      <pose>10 3 0.1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.3</radius></sphere>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target marker 2 -->
    <model name="target_2">
      <pose>-8 6 0.1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.3</radius></sphere>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
